# ==============================================================================
# GeoHarmonizer AI - Supabase Cloud Configuration (SIH26013)
# ==============================================================================

# 1. Supabase Project REST & Auth Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase PostgreSQL Direct / Pooled Connection String (Required for Migration Runner)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Mode: Session (port 5432) or Transaction Pooler (port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:YourDatabasePassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional: If you prefer specifying password separately:
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_DB_PASSWORD=YourDatabasePassword

# 3. Google Gemini API Key (For GeoHarmonizer AI Copilot Chatbot)
# Get your API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

